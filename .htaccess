RewriteEngine On

# Definir la base de la reescritura para este proyecto
RewriteBase /proyectoPPI115/

# Si piden un archivo o carpeta real, Apache lo entrega directo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Si no existe el archivo físico, manda la petición limpiamente a index.php
RewriteRule ^ index.php [QSA,L]
